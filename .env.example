# ===== Majburiy =====
DB_PASSWORD=ozgartiring_kuchli_parol
# Kamida 32 belgi. Yaratish: openssl rand -base64 48
APP_JWT_SECRET=ozgartiring_kamida_32_belgili_tasodifiy_satr_bu_yerga
# Birinchi ishga tushishda admin yaratiladi (keyin o'chirib qo'yish mumkin)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=ozgartiring_admin_parol

# ===== Ixtiyoriy =====
# docker-compose.yml da standart 80, docker-compose.prod.yml (VPS) da 8090.
# VPS da band bo'lmagan portni tanlang — band bo'lsa deploy boshqa servisni to'xtatmaydi, xato beradi.
HTTP_PORT=80
# 127.0.0.1 = faqat serverdagi mavjud nginx/caddy orqali (tashqaridan to'g'ridan-to'g'ri yopiq)
HTTP_BIND=0.0.0.0
# Brauzerda ochiladigan manzil(lar), vergul bilan: http://SERVER_IP:8090,https://crm.example.uz
APP_CORS_ORIGINS=http://localhost
# log = SMS yuborilmaydi (faqat log), eskiz = Eskiz.uz orqali
APP_SMS_PROVIDER=log
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# MIB (Majburiy ijro byurosi) qarzdorligini JShShIR bo'yicha tekshirish.
# none = ulanmagan (natija qo'lda kiritiladi), stub = demo (haqiqiy MIB emas), http = umumiy HTTP adapter
APP_MIB_PROVIDER=none
# http uchun: manzil ({pinfl} o'rniga JShShIR qo'yiladi), usul, token va javob maydonlari yo'li
APP_MIB_URL=
APP_MIB_METHOD=GET
APP_MIB_TOKEN=
APP_MIB_AUTH_HEADER=Authorization
APP_MIB_AUTH_SCHEME=Bearer
APP_MIB_TIMEOUT=10
APP_MIB_DEBT_FLAG_PATH=
APP_MIB_AMOUNT_PATH=
APP_MIB_CASES_PATH=
APP_MIB_MESSAGE_PATH=
APP_MIB_NOT_FOUND_CLEAR=true
# Tashqi nasiya platformalaridagi (Uzum, Anor, Alif, Payme ...) limitni JShShIR bo'yicha tekshirish.
# mock = namoyish ma'lumotlari; haqiqiy integratsiya hali ulanmagan
APP_LIMITS_PROVIDER=mock
APP_TELEGRAM_BOT_TOKEN=
BACKUP_KEEP_DAYS=14
# Demo ma'lumotlar bilan sinash uchun: dev   (mijoz serverida BO'SH qoldiring)
SPRING_PROFILES_ACTIVE=
